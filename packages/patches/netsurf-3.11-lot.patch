+/* Replace the image and backing pixmap with ones of a new size, keeping the
+ * window, gc and connection: the window was resized (e.g. maximised by the
+ * window manager) and the frontend asked for a matching framebuffer.
+ */
+static int
+x_resize(nsfb_t *nsfb, int width, int height)
+{
+    xstate_t *xstate = nsfb->surface_priv;
+    xcb_image_t *old = xstate->image;
+    xcb_image_t *image = NULL;
+
+    if (xstate->shminfo.shmseg != 0) {
+        xcb_shm_detach(xstate->connection, xstate->shminfo.shmseg);
+        shmdt(xstate->shminfo.shmaddr);
+        xstate->shminfo.shmseg = 0;
+        old->base = NULL; /* shared memory, not malloc'd: don't free() it */
+        image = create_shm_image(xstate, width, height, nsfb->bpp);
+    }
+    if (image == NULL)
+        image = create_image(xstate->connection, width, height, nsfb->bpp);
+    if (image == NULL)
+        return -1;
+    xcb_image_destroy(old);
+    xstate->image = image;
 
+    xcb_free_pixmap(xstate->connection, xstate->pmap);
+    xstate->pmap = xcb_generate_id(xstate->connection);
+    xcb_create_pixmap(xstate->connection, 24, xstate->pmap, xstate->window,
+                      image->width, image->height);
 
+    nsfb->ptr = image->data;
+    nsfb->linelen = image->stride;
+    return 0;
+}
