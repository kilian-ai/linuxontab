+		if (ox < 0) ox = 0;
+		if (oy < 0) oy = 0;
+		if (s > 1)
+			PutScaled(s, ox, oy);
+		else if (shmmode)
+			XShmPutImage(dpy, win, gc, img, 0, 0, ox, oy, 320, 200, False);
+		else
+			XPutImage(dpy, win, gc, img, 0, 0, ox, oy, 320, 200);
+	}
 }
 
