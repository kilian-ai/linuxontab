+/* Put the 32bpp frame (disbuf) enlarged by a whole factor s at (ox, oy).
+ * Xlib splits the PutImage to fit the server's maximum request length. */
+static void PutScaled(int s, int ox, int oy)
+{
+	int x, y, k, w = 320 * s;
+	dword *src = (dword *)disbuf, *row;
+
+	if (simg == NULL || simg_scale != s) {
+		char *data;
+		if (simg != NULL) {
+			XDestroyImage(simg);	/* frees its data too */
+			simg = NULL;
+		}
+		data = malloc((size_t)w * 200 * s * 4);
+		if (data == NULL)
+			return;
+		simg = XCreateImage(dpy, vi->visual, vi->depth, ZPixmap, 0,
+				    data, w, 200 * s, 32, w * 4);
+		if (simg == NULL) {
+			free(data);
+			return;
+		}
+		simg_scale = s;
+	}
+	for (y = 0; y < 200; y++) {
+		row = (dword *)simg->data + (size_t)y * s * w;
+		for (x = 0; x < 320; x++)
+			for (k = 0; k < s; k++)
+				row[x * s + k] = src[y * 320 + x];
+		for (k = 1; k < s; k++)
+			memcpy(row + (size_t)k * w, row, (size_t)w * 4);
+	}
+	XPutImage(dpy, win, gc, simg, 0, 0, ox, oy, w, 200 * s);
 }
 
