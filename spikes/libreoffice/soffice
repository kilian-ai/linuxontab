#!/bin/sh
# soffice with the guest's profile under $HOME, for everything that isn't
# Writer's window — e.g. headless conversion:
#   /opt/lo/soffice --headless --convert-to pdf --outdir /tmp /tmp/notes.txt
# (No SAL_USE_VCLPLUGIN here: forcing gen makes --headless open the X display.)
[ "$HOME" = "/" ] && HOME=/root
[ -n "$HOME" ] || HOME=/root
export HOME
mkdir -p "$HOME/.config"
exec /opt/lo/program/soffice.bin "-env:UserInstallation=file://$HOME/.config/libreoffice" "$@"
