#!/bin/sh
# C/C++ compiler driver for LibreOffice (and its stack) -> wasm32 on the
# LinuxOnTab kernel. Installed as wasm-cc and wasm-c++ (the name picks the
# language).
#   compile: clang --target=wasm32 + toolchain/cpp-eh-sysroot, wasm exceptions,
#            native wasm setjmp/longjmp, the Linux/Unix predefines clang does
#            not set for an unknown-OS wasm target, the guest's X11 headers
#   link:    crt1 + the sysroot shims (per-thread stacks/TLS, locked dlmalloc,
#            userspace mmap, binary128 long double, setjmp runtime, 1 GiB+
#            memory opt-in) + libc++/abi/unwind/libc
SYSROOT="${LOT_SYSROOT:-/lot/toolchain/cpp-eh-sysroot}"
SHIMS="${LOT_SHIMS:-/work/shims}"
XPREFIX="${LOT_XPREFIX:-/work/xprefix}"
case "$(basename "$0")" in *++) DRV=clang++ ;; *) DRV=clang ;; esac

# Drop what a wasm32 target cannot take, for compiles and links alike:
# ELF-only linker options that build systems add for "Linux" (rpaths, -z
# origin, version scripts, sonames, --as-needed, --start/--end-group:
# wasm-ld resolves archives regardless of order) and x86 SIMD flags.
skip=0
for a in "$@"; do
  shift
  if [ $skip = 1 ]; then skip=0; continue; fi
  case "$a" in
    -Wl,-rpath|-Wl,-rpath-link|-Wl,--rpath) skip=1; continue ;;   # libtool: -Wl,-rpath -Wl,<dir>
    -Wl,*ORIGIN*) continue ;;
    -Wl,-Bdynamic|-Wl,-Bstatic|-Wl,-call_shared|-Wl,-dy|-Wl,-dn) continue ;;   # all static: see -static below
    -Wl,--start-group|-Wl,--end-group|--start-group|--end-group) continue ;;
    -Wl,*rpath*|-Wl,-z,origin|-Wl,-zorigin|-Wl,-z,defs|-Wl,-z,combreloc|-Wl,-z,relro|-Wl,-z,now|-Wl,-z,noexecstack) continue ;;
    -Wl,--hash-style=*|-Wl,--as-needed|-Wl,--no-as-needed|-Wl,--version-script=*|-Wl,--version-script|-Wl,-soname,*|-Wl,-Bsymbolic*|-Wl,--no-undefined|-Wl,--enable-new-dtags|-Wl,--build-id*|-Wl,-O1|-Wl,--gc-sections|-Wl,-noinhibit-exec|-Wl,--noinhibit-exec) continue ;;
    -mavx*|-mno-avx*|-msse*|-mno-sse*|-mssse3|-mpopcnt|-mfma|-mf16c|-mbmi*|-mlzcnt|-mfpmath=*|-march=*|-mtune=*|-mpclmul|-maes) continue ;;
  esac
  set -- "$@" "$a"
done

mode=link
for a in "$@"; do
  case "$a" in -c|-E|-S|-M|-MM|-fsyntax-only|--version|-v|-dumpversion|-dumpmachine|-print-*) mode=compile ;; esac
done
COMMON="--target=wasm32-unknown-unknown --sysroot=$SYSROOT -matomics -mbulk-memory -fwasm-exceptions -pthread"
DEFS="-D__linux__ -D__linux -D__unix__ -D__unix -D__gnu_linux__"
# the guest's X11 client headers, searched last, as /usr/include would be
[ -d "$XPREFIX/include" ] && DEFS="$DEFS -idirafter $XPREFIX/include"
if [ $mode = compile ]; then
  exec $DRV $COMMON $DEFS -mllvm -wasm-enable-sjlj "$@"
fi

# No shared libraries on wasm: third-party makefiles that build a .so next to
# the static library they are used for (argon2...) get an empty placeholder.
for a in "$@"; do
  if [ "$a" = "-shared" ]; then
    out=; prev=
    for b in "$@"; do [ "$prev" = "-o" ] && out="$b"; prev="$b"; done
    echo "wasm-cc: no shared libraries on wasm32; writing an empty ${out:-a.out}" >&2
    : > "${out:-a.out}"
    exit 0
  fi
done
# Static X11: libX11/libXinerama need their dependencies named, plus the
# symbols our reduced libX11 omits (xlibi18n, input methods: libX11compat)
XDEPS=
for a in "$@"; do
  case "$a" in -lX11|-lXinerama|-lXext|-lXrender|-lXrandr|*/libX11.a) XDEPS="-lXext -lX11 -lxcb -lXau -lX11compat"; break ;; esac
done
# a compile-and-link in one step still needs the setjmp lowering for its sources
SJLJ=
for a in "$@"; do
  case "$a" in *.c|*.cc|*.cpp|*.cxx|*.C|*.m|*.mm) SJLJ="-mllvm -wasm-enable-sjlj"; break ;; esac
done
BUILTINS="$SYSROOT/lib/clang/19/lib/wasm32-unknown-linux-musl/libclang_rt.builtins.a"
[ -n "${LOT_DEBUG_LINK:-}" ] && { echo "wasm-cc link: argc=$# xdeps=[$XDEPS]" >&2; printf '%s\n' "$@" | grep -c . >&2; }
# -static: a link line that ends in -Wl,-Bdynamic (LibreOffice's does) would
# otherwise resolve our trailing -lc to the sysroot's libc.so
# wasm-ld >= 20: 19's lazy archive scan registers members' *local* symbols as
# lazy definitions, so a reference to a global that shares its name with a
# static elsewhere (argon2's fill_segment vs OpenSSL's) extracts the wrong
# member and is silently bound to function 0 / address 0 (invalid module).
WASM_LD=${LOT_WASM_LD:-/usr/lib/llvm-20/bin/wasm-ld}
[ -x "$WASM_LD" ] || { echo "wasm-cc: need wasm-ld >= 20 at $WASM_LD (apt.llvm.org lld-20)" >&2; exit 1; }
exec $DRV $COMMON $DEFS $SJLJ -nostdlib -static -fuse-ld="$WASM_LD" \
  -Wl,--import-memory -Wl,--export-memory -Wl,--export-table -Wl,--shared-memory \
  -Wl,--export=__heap_base -Wl,--export=__data_end -Wl,--table-base=2 \
  -Wl,--max-memory=${LOT_MAX_MEMORY:-2147483648} -Wl,-z,stack-size=${LOT_STACK:-8388608} \
  "$SYSROOT/lib/crt1.o" -L"$XPREFIX/lib" "$@" $XDEPS \
  "$SHIMS/wasm_dlmalloc_mt.o" "$SHIMS/wasm_clone.o" "$SHIMS/wasm_mmap.o" "$SHIMS/wasm_ld128.o" \
  "$SHIMS/sjlj_rt.o" "$SHIMS/lot_big_memory.o" "$SHIMS/wasm_syscall_cp.o" "$SHIMS/wasm_cxa_thread_atexit.o" \
  -Wl,--wrap=__main_argc_argv "$SHIMS/libuncaughtmain.a" \
  -lc++ -lc++abi -lunwind -lc -lm "$SHIMS/libforkenosys.a" "$BUILTINS" ${LOT_LINK_EXTRA:-}
