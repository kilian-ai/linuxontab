diff --git a/blink/memorymalloc.c b/blink/memorymalloc.c
index 7d5cc93..464beef 100644
--- a/blink/memorymalloc.c
+++ b/blink/memorymalloc.c
@@ -74,14 +74,25 @@ static u64 TrackHostPage(u8 *ptr) {
   if (HasLinearMapping()) {
     return (uintptr_t)ptr;
   } else {
+    // LinuxOnTab: nolinear mode (every 32-bit host) appended here without a
+    // lock, so two threads allocating at once could get the same index: two
+    // guest pages aliasing one host page (threaded guests like Node crashed
+    // on garbage pointers). Appends are serialized now. Readers (FindHostPage)
+    // still index the array without a lock, so a realloc that moves it can
+    // race with them: start big (1M entries) so that almost never happens.
+    // (Growing by copy without ever freeing the old array broke page lookups
+    // on the wasm build for reasons not yet understood; realloc is kept.)
+    static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+    pthread_mutex_lock(&lock);
     if (g_hostpages.n == g_hostpages.c) {
-      g_hostpages.c += 1;
-      g_hostpages.c += g_hostpages.c >> 1;
+      g_hostpages.c = g_hostpages.c ? g_hostpages.c * 2 : 1 << 20;
       g_hostpages.p =
           realloc(g_hostpages.p, g_hostpages.c * sizeof(*g_hostpages.p));
+      unassert(g_hostpages.p);
     }
     entry = g_hostpages.n++;
     g_hostpages.p[entry] = ptr;
+    pthread_mutex_unlock(&lock);
     return entry << 12;
   }
 }
