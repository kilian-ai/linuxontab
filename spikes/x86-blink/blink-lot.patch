+#ifdef LOT_VFORK
+/*
+ * LinuxOnTab: vfork with shared memory.
+ *
+ * The wasm kernel refuses a memory-copying clone while another thread shares
+ * the address space (arch/wasm/kernel/fork.c: the snapshot can't be made
+ * coherent), so a threaded guest could not start children. Instead the guest
+ * child runs in a host clone(CLONE_VM|CLONE_VFORK): a real separate process
+ * (own pid, own host fd table) that shares memory, while the calling host
+ * thread waits in the kernel until the child execs or exits.
+ *
+ * The child gets its own copy of Blink's System (guest fd table, pid, signal
+ * handler table), sharing only the guest page tables, and its own Machine
+ * cloned from the caller. Guest vfork() / clone(CLONE_VM|CLONE_VFORK)
+ * (posix_spawn) are exactly this. A plain guest fork() in a threaded process
+ * takes the same path, but its child resumes on the parent's x86 stack and
+ * would overwrite the parent's fork()/_Fork() frames on its way to exec. So
+ * the child gets private copies of that stack window through its own page
+ * table path (LotCowStack): copy-on-fork for the pages it will write, shared
+ * memory for everything else. An earlier snapshot + restore of the window
+ * also threw away writes the parent's OTHER threads made there meanwhile
+ * (Node hung or crashed in async child_process).
+ */
+int __clone(int (*)(void *), void *, int, void *, ...);
+
+#define LOT_VFORK_HOST_STACK (1 << 20)
+#define LOT_VFORK_COW_MAX (256 * 1024)  // stack window above rsp
+#define LOT_VFORK_COW_PAGES 512           // tables + leaves allocated for it
+
+struct LotVforkArg {
+  struct System *parent;
+  struct Machine *m2;
+  u64 flags;
+  u64 ctid;
+};
+
+/*
+ * Blink normally runs an x86 execve() in-process: it wipes the guest address
+ * space and loads the new program into it. A vfork child shares that address
+ * space with its parent, so it must get a new process image instead: host
+ * execve() of Blink itself with the x86 program (-0 keeps the guest argv[0]).
+ */
+static char g_lot_self[PATH_MAX];
+
+static int LotHostExec(char *execfn, char *prog, char **argv, char **envp) {
+  int n, k = 0;
+  char **nv;
+  (void)execfn;
+  for (n = 0; argv[n]; ++n) {
+  }
+  if (!(nv = (char **)malloc((n + 5) * sizeof(*nv)))) return 127;
+  nv[k++] = g_lot_self;
+  nv[k++] = (char *)"-0";  // blink -0 PROG ARGV0 ARGS...
+  nv[k++] = prog;
+  nv[k++] = argv[0] ? argv[0] : prog;
+  for (int i = 1; i < n; ++i) nv[k++] = argv[i];
+  nv[k] = 0;
+  execve(g_lot_self, nv, envp);
+  return 127;
+}
+
+/*
+ * Blink pins guest pages while a syscall reads them (PAGE_LOCKS counts in the
+ * page-table entries) and unpins them when the syscall returns. A vfork child
+ * that execs or exits never returns from that syscall, and its page tables
+ * are the parent's: the pins would stay forever and the parent would hang in
+ * FreePage() when it tears down its address space at exit. So a vfork child
+ * drops all its pins before execve/exit (the arguments are already copied
+ * out) and wakes page-lock waiters in the PARENT's System too (its own
+ * System is a copy with its own condition variable). Thread-local: the child
+ * has its own TLS block (sysroot/wasm_clone.c) but shares every global with the parent.
+ */
+static _Thread_local struct System *g_lot_vfork_parent;
+
+static void LotVforkUnpin(struct Machine *m) {
+  int depth;
+  if (!g_lot_vfork_parent) return;
+  depth = m->sysdepth;
+  m->sysdepth = 0;
+  CollectPageLocks(m);
+  m->sysdepth = depth;
+  LOCK(&g_lot_vfork_parent->pagelocks_lock);
+  pthread_cond_broadcast(&g_lot_vfork_parent->pagelocks_cond);
+  UNLOCK(&g_lot_vfork_parent->pagelocks_lock);
+}
+
+static int LotVforkChild(void *arg) {
+  struct LotVforkArg *a = (struct LotVforkArg *)arg;
+  struct Machine *m2 = a->m2;
+  _Atomic(int) *ctid_ptr;
+  int pid = getpid();
+  g_lot_vfork_parent = a->parent;
+  m2->system->pid = pid;
+  m2->tid = pid;
+  m2->thread = pthread_self();
+  if ((a->flags & CLONE_CHILD_SETTID_LINUX) && !(a->ctid & 3) &&
+      (ctid_ptr = (_Atomic(int) *)LookupAddress(m2, a->ctid))) {
+    atomic_store_explicit(ctid_ptr, Little32(pid), memory_order_release);
+  }
+  Blink(m2);  // ends in a host execve() or _exit()
+}
+
+static void LotFreeFdsCopy(struct Fds *fds) {
+  struct Dll *e;
+  while ((e = dll_first(fds->list))) {  // bookkeeping only: never close()
+    struct Fd *fd = FD_CONTAINER(e);
+    dll_remove(&fds->list, e);
+    free(fd->path);
+    free(fd);
+  }
+}
+
+struct LotCow {
+  int n;
+  u8 *page[LOT_VFORK_COW_PAGES];
+  bool table[LOT_VFORK_COW_PAGES];
+};
+
+static u8 *LotCowAlloc(struct System *s, struct LotCow *c, bool table,
+                       u64 *entry) {
+  u64 e;
+  u8 *p;
+  if (c->n == LOT_VFORK_COW_PAGES) return 0;
+  e = table ? AllocatePageTable(s) : AllocateAnonymousPage(s);
+  if (e == (u64)-1) return 0;
+  p = GetPageAddress(s, e, false);
+  c->page[c->n] = p;
+  c->table[c->n++] = table;
+  *entry = e;
+  return p;
+}
+
+static bool LotCowOwns(struct LotCow *c, u8 *p) {
+  for (int i = 0; i < c->n; ++i) {
+    if (c->page[i] == p) return true;
+  }
+  return false;
+}
+
+static void LotCowFree(struct System *s, struct LotCow *c) {
+  for (int i = 0; i < c->n; ++i) {
+    FreeAnonymousPage(s, c->page[i]);
+    s->rss -= 1;
+    if (c->table[i]) s->memstat.tables -= 1;
+  }
+  c->n = 0;
+}
+
+// Point s2 at its own page-table root and give it private copies of every
+// committed page in [lo, hi), copying each intermediate table on the way the
+// first time the walk goes through it. Pages outside the window, and pages in
+// it that are only reserved, stay shared (a reserved page the child commits
+// lands in its private table; that page is not reclaimed afterwards).
+static bool LotCowStack(struct System *s, struct System *s2, u64 lo, u64 hi,
+                        struct LotCow *c) {
+  u64 root, page, e, ne;
+  u8 *tbl, *slot, *np;
+  unsigned level;
+  if (!(tbl = LotCowAlloc(s, c, true, &root))) return false;
+  memcpy(tbl, GetPageAddress(s, s->cr3, true), 4096);
+  s2->cr3 = root;
+  for (page = lo; page < hi; page += 4096) {
+    tbl = GetPageAddress(s, root, true);
+    for (level = 39;; level -= 9) {
+      slot = tbl + ((page >> level) & 511) * 8;
+      e = LoadPte(slot);
+      if (!(e & PAGE_V) || (e & PAGE_RSRV)) break;  // unmapped / uncommitted
+      if (level > 12 && (e & PAGE_PS)) break;        // huge page: stays shared
+      if (!(e & PAGE_HOST)) break;                   // real-mode memory
+      if (level == 12) {
+        if (!(np = LotCowAlloc(s, c, false, &ne))) return false;
+        memcpy(np, GetPageAddress(s, e, false), 4096);
+        StorePte(slot, (ne & PAGE_TA) | PAGE_HOST |
+                           (e & ~(PAGE_TA | PAGE_LOCKS | PAGE_MAP | PAGE_MUG |
+                                  PAGE_FILE)));
+        break;
+      }
+      if (!LotCowOwns(c, GetPageAddress(s, e, false))) {
+        if (!(np = LotCowAlloc(s, c, true, &ne))) return false;
+        memcpy(np, GetPageAddress(s, e, false), 4096);
+        StorePte(slot, (ne & PAGE_TA) | (e & ~PAGE_TA));
+        e = LoadPte(slot);
+      }
+      tbl = GetPageAddress(s, e, false);
+    }
+  }
+  return true;
+}
+
+static int LotVfork(struct Machine *m, u64 flags, u64 stack, u64 ctid,
+                    bool savestack) {
+  int pid;
+  struct Dll *e;
+  struct System *s = m->system, *s2;
+  struct Machine *m2;
+  struct LotVforkArg arg;
+  struct LotCow *cow = 0;
+  char *hstack;
+  if (!(s2 = (struct System *)malloc(sizeof(*s2)))) {
+    return enomem();
+  }
+  LOCK(&s->sig_lock);
+  LOCK(&s->fds.lock);
+  memcpy(s2, s, sizeof(*s2));
+  InitFds(&s2->fds);
+  for (e = dll_last(s->fds.list); e; e = dll_prev(s->fds.list, e)) {
+    struct Fd *fd = FD_CONTAINER(e);
+    ForkFd(&s2->fds, fd, fd->fildes, fd->oflags);
+  }
+  UNLOCK(&s->fds.lock);
+  UNLOCK(&s->sig_lock);
+#ifdef HAVE_THREADS
+  unassert(!pthread_cond_init(&s2->machines_cond, 0));
+  unassert(!pthread_mutex_init(&s2->machines_lock, 0));
+  unassert(!pthread_cond_init(&s2->pagelocks_cond, 0));
+  unassert(!pthread_mutex_init(&s2->pagelocks_lock, 0));
+  unassert(!pthread_mutex_init(&s2->exec_lock, 0));
+  unassert(!pthread_mutex_init(&s2->sig_lock, 0));
+  unassert(!pthread_mutex_init(&s2->mmap_lock, 0));
+#endif
+  s2->machines = 0;
+  s2->filemaps = 0;
+  s2->isfork = true;
+  if (s2->exec) {
+    if (!g_lot_self[0]) {
+      ssize_t r = readlink("/proc/self/exe", g_lot_self, sizeof(g_lot_self) - 1);
+      if (r > 0) {
+        g_lot_self[r] = 0;
+      } else if (g_blink_path) {
+        snprintf(g_lot_self, sizeof(g_lot_self), "%s", g_blink_path);
+      }
+    }
+    s2->exec = LotHostExec;
+  }
+  if (savestack) {
+    u64 lo = (Get64(m->sp) - 128) & -4096;
+    bool ok;
+    if (!(cow = (struct LotCow *)calloc(1, sizeof(*cow)))) {
+      LotFreeFdsCopy(&s2->fds);
+      free(s2);
+      return enomem();
+    }
+    LOCK(&s->mmap_lock);
+    ok = LotCowStack(s, s2, lo, lo + LOT_VFORK_COW_MAX, cow);
+    UNLOCK(&s->mmap_lock);
+    if (!ok) {
+      LotCowFree(s, cow);
+      free(cow);
+      LotFreeFdsCopy(&s2->fds);
+      free(s2);
+      return enomem();
+    }
+  }
+  if (!(m2 = NewMachine(s, m))) {
+    if (cow) LotCowFree(s, cow), free(cow);
+    LotFreeFdsCopy(&s2->fds);
+    free(s2);
+    return eagain();
+  }
+  LOCK(&s->machines_lock);
+  dll_remove(&s->machines, &m2->elem);
+  UNLOCK(&s->machines_lock);
+  m2->system = s2;
+  dll_make_first(&s2->machines, &m2->elem);
+  ResetTlb(m2);  // NewMachine copied the parent's TLB: stale with a new cr3
+  Put64(m2->ax, 0);
+  if (stack) Put64(m2->sp, stack);
+  m2->ctid = (flags & CLONE_CHILD_CLEARTID_LINUX) ? ctid : 0;
+  arg.parent = s;
+  arg.m2 = m2;
+  arg.flags = flags;
+  arg.ctid = ctid;
+  if (!(hstack = (char *)malloc(LOT_VFORK_HOST_STACK))) {
+    pid = -ENOMEM;
+  } else {
+    pid = __clone(LotVforkChild, hstack + LOT_VFORK_HOST_STACK - 16,
+                  CLONE_VM | CLONE_VFORK | SIGCHLD, &arg);
+    free(hstack);  // the child has exec'd or exited: its stack is ours again
+  }
+  if (cow) {
+    LOCK(&s->mmap_lock);
+    LotCowFree(s, cow);
+    UNLOCK(&s->mmap_lock);
+    free(cow);
+  }
+  LotFreeFdsCopy(&s2->fds);
+  free(s2);
+  free(m2);
+  if (pid < 0) {
+    errno = -pid;
+    return -1;
+  }
+  THR_LOGF("pid=%d tid=%d LotVfork -> pid=%d", s->pid, m->tid, pid);
+  return pid;
+}
+#endif /* LOT_VFORK */
