+#include <sys/eventfd.h>
+#define EFD_SEMAPHORE_LINUX 1
+#define EFD_NONBLOCK_LINUX 04000
+#define EFD_CLOEXEC_LINUX 02000000
+
+static i32 SysEventfd2(struct Machine *m, u32 initval, i32 flags) {
+  int lim, fildes, oflags = O_RDWR, sysflags = 0;
+  if (flags & ~(EFD_SEMAPHORE_LINUX | EFD_NONBLOCK_LINUX | EFD_CLOEXEC_LINUX)) {
+    LOGF("unsupported %s flags: %#x", "eventfd2", flags);
+    return einval();
+  }
+  if (flags & EFD_SEMAPHORE_LINUX) sysflags |= EFD_SEMAPHORE;
+  if (flags & EFD_NONBLOCK_LINUX) sysflags |= EFD_NONBLOCK, oflags |= O_NONBLOCK;
+  if (flags & EFD_CLOEXEC_LINUX) sysflags |= EFD_CLOEXEC, oflags |= O_CLOEXEC;
+  if (!(lim = GetFileDescriptorLimit(m->system))) return emfile();
+  if ((fildes = eventfd(initval, sysflags)) != -1) {
+    if (fildes >= lim) {
+      close(fildes);
+      fildes = emfile();
+    } else {
+      LOCK(&m->system->fds.lock);
+      unassert(AddFd(&m->system->fds, fildes, oflags));
+      UNLOCK(&m->system->fds.lock);
+    }
+  }
+  return fildes;
+}
+
+static i32 SysEventfd(struct Machine *m, u32 initval) {
+  return SysEventfd2(m, initval, 0);
+}
