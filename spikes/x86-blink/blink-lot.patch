+#ifdef LOT_SYSCALLS
+// is a page mapped at all (any protection)? a read-only page-table walk:
+// unlike FindPageTableEntry() it neither takes page locks nor commits
+// reserved pages
+static bool LotIsMapped(struct Machine *m, u64 page) {
+  u8 *pslot;
+  u64 entry;
+  unsigned level;
+  if (!(-0x800000000000 <= (i64)page && (i64)page < 0x800000000000)) {
+    return false;
+  }
+  entry = m->system->cr3;
+  level = 39;
+  do {
+    pslot = GetPageAddress(m->system, entry, level == 39);
+    if (!pslot) return false;
+    entry = LoadPte(pslot + ((page >> level) & 511) * 8);
+    if (!(entry & PAGE_V)) return false;
+    if ((entry & PAGE_PS) && level > 12) return true;
+  } while ((level -= 9) >= 12);
+  return true;
+}
+#endif
