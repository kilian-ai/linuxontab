#!/bin/sh
# Shared setup for the x86 Node wrappers (sourced). x86 processes see the
# Alpine root at /opt/x86/root first (BLINK_OVERLAYS); the loader only
# searches that root's library dirs (etc/ld-musl-x86_64.path), so host libs
# with the same names are never picked up.
export BLINK_OVERLAYS=/opt/x86/root:
# V8 can't generate code for an emulated CPU fast enough to pay off; every
# node npm spawns inherits this.
export NODE_OPTIONS="--jitless${NODE_OPTIONS:+ $NODE_OPTIONS}"
[ "${HOME:-/}" = / ] && HOME=/root
export HOME
# npm's writable state lives in /opt/npm (the x86 disk is read-only and the
# rootfs is nearly full); x86-node-setup mounts a tmpfs there.
export npm_config_prefix=/opt/npm npm_config_cache=/opt/npm/cache
export npm_config_update_notifier=false npm_config_fund=false npm_config_audit=false
export PATH="/opt/npm/bin:$PATH"
