+    if ((p = map_shared(len, fd, off))) return p;
+    errno = ENOMEM;
+    return MAP_FAILED;
+  }
   if (posix_memalign(&p, 4096, len)) {
     /* say so: Blink turns a failed page allocation into a guest SIGSEGV at a
      * random place, which otherwise looks like memory corruption */
@@ -64,7 +217,7 @@
   }
   if (flags & MAP_ANON) {
     memset(p, 0, len);
-    track(p);
+    track(p, len);
     return p;
   }
