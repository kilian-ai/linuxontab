#!/bin/sh
# lot-bridge — persistent WS↔TCP bridge pool (shell implementation)
# CLI: up PORT [PORT...] / down / status / --version
# Requires: websocat, curl
# Env: LOT_BRIDGE_RELAY=https://...  LOT_BRIDGE_POOL=N

trap '' HUP

RELAY="${LOT_BRIDGE_RELAY:-https://linuxontab-tunnel.fly.dev}"
POOL="${LOT_BRIDGE_POOL:-4}"

CODE_FILE=/tmp/lot-bridge.code
PID_FILE=/tmp/lot-bridge.pid
PIDS_FILE=/tmp/lot-bridge.pids
STATUS_FILE=/tmp/lot-bridge.status.json
EXPOSE_FILE=/tmp/lot-bridge.expose.json

relay_ws() {
    # Use wss:// (Fly HTTP proxy port 443). Port 4344 (TCP proxy, RAW_PORT) was
    # intended to bypass the Fly HTTP proxy 30s write-timeout, but it is NOT
    # reachable from same-org Fly 6PN (linuxontab-net WISP server uses 6PN which
    # bypasses the [[services]] TCP proxy, so port 4344 is invisible internally).
    # wss:// works from both public internet and Fly 6PN.
    case "$RELAY" in
        https://*) echo "wss://${RELAY#https://}" ;;
        http://*)  echo "ws://${RELAY#http://}" ;;
        *)         echo "$RELAY" ;;
    esac
}

kill_bridges() {
    if [ -s "$PIDS_FILE" ]; then
        while IFS= read -r pid; do
            kill -9 "$pid" 2>/dev/null || true
        done < "$PIDS_FILE"
    fi
    pkill -9 -f 'websocat.*port/guest' 2>/dev/null || true
    sleep 1
    pkill -9 -f 'websocat.*port/guest' 2>/dev/null || true
    rm -f "$PIDS_FILE"
}

cmd_up() {
    PORTS=""
    for a in "$@"; do
        case "$a" in [0-9]*) PORTS="$PORTS $a" ;; esac
    done
    PORTS="${PORTS# }"
    if [ -z "$PORTS" ]; then
        printf 'usage: lot-bridge up PORT [PORT ...]\n' >&2
        exit 1
    fi

    # Build comma-separated port list for JSON
    PORTS_JSON=""
    for p in $PORTS; do
        if [ -n "$PORTS_JSON" ]; then
            PORTS_JSON="${PORTS_JSON},$p"
        else
            PORTS_JSON="$p"
        fi
    done

    # Kill any prior instance
    if [ -s "$PID_FILE" ]; then
        kill "$(cat "$PID_FILE")" 2>/dev/null || true
        sleep 1
    fi
    kill_bridges
    rm -f "$CODE_FILE" "$STATUS_FILE"

    # Register with relay
    REG=$(curl -sS --max-time 15 \
        -X POST "${RELAY}/port/register" \
        -H 'Content-Type: application/json' \
        -d "{\"ports\":[$PORTS_JSON]}" 2>&1)
    CODE=$(printf '%s' "$REG" | sed -n 's/.*"code":"\([A-Z0-9]*\)".*/\1/p')

    if [ -z "$CODE" ]; then
        printf 'lot-bridge: registration failed: %s\n' "$REG" >&2
        exit 1
    fi

    printf '%s' "$CODE" > "$CODE_FILE"
    printf '%s' "$$" > "$PID_FILE"
    printf '' > "$PIDS_FILE"
    printf '{}' > "$EXPOSE_FILE"

    WS=$(relay_ws)
    STARTED=$(date +%s 2>/dev/null || echo 0)

    printf 'lot-bridge: code=%s relay=%s ports=%s pool=%s\n' \
        "$CODE" "$RELAY" "$PORTS_JSON" "$POOL"

    # Request a direct TCP expose slot for each port
    EXPOSE_JSON='{'
    FIRST_EXP=1
    for PORT in $PORTS; do
        EXP=$(curl -sS --max-time 10 \
            -X POST "${RELAY}/port/expose" \
            -H 'Content-Type: application/json' \
            -d "{\"code\":\"${CODE}\",\"port\":${PORT},\"preferPort\":${PORT}}" 2>/dev/null)
        PUBPORT=$(printf '%s' "$EXP" | sed -n 's/.*"publicPort":\([0-9]*\).*/\1/p')
        HOST=$(printf '%s' "$EXP" | sed -n 's/.*"host":"\([^"]*\)".*/\1/p')
        if [ -n "$PUBPORT" ]; then
            printf 'lot-bridge: port %s → %s:%s (direct TCP)\n' "$PORT" "$HOST" "$PUBPORT"
            if [ "$FIRST_EXP" = 1 ]; then
                EXPOSE_JSON="${EXPOSE_JSON}\"${PORT}\":{\"host\":\"${HOST}\",\"publicPort\":${PUBPORT}}"
                FIRST_EXP=0
            else
                EXPOSE_JSON="${EXPOSE_JSON},\"${PORT}\":{\"host\":\"${HOST}\",\"publicPort\":${PUBPORT}}"
            fi
        fi
    done
    EXPOSE_JSON="${EXPOSE_JSON}}"
    printf '%s' "$EXPOSE_JSON" > "$EXPOSE_FILE"

    # Spawn bridge pool
    for PORT in $PORTS; do
        i=0
        while [ "$i" -lt "$POOL" ]; do
            i=$((i + 1))
            (
                trap '' HUP
                echo -500 > /proc/self/oom_score_adj 2>/dev/null || true
                while :; do
                    echo -500 > /proc/self/oom_score_adj 2>/dev/null || true
                    websocat --binary --ping-interval 25 --ping-timeout 300 \
                        "${WS}/port/guest?code=${CODE}&port=${PORT}" \
                        "sh-c:sleep 0.3; exec nc 127.0.0.1 ${PORT}" \
                        >> /tmp/lot-bridge.log 2>&1
                    sleep 0.1 2>/dev/null || sleep 1
                done
            ) &
            printf '%s\n' "$!" >> "$PIDS_FILE"
        done
    done

    # Cleanup trap
    cleanup() {
        kill_bridges
        curl -sS --max-time 5 \
            -X POST "${RELAY}/port/unregister" \
            -H 'Content-Type: application/json' \
            -d "{\"code\":\"${CODE}\"}" >/dev/null 2>&1 || true
        rm -f "$CODE_FILE" "$PID_FILE" "$STATUS_FILE"
        exit 0
    }
    trap cleanup TERM INT

    # Status loop
    while :; do
        NOW=$(date +%s 2>/dev/null || echo 0)
        UPTIME=$(( NOW - STARTED ))
        # Count live websocat guest-bridge processes (not just spawned PIDs).
        # The [w] trick prevents grep from matching its own process line.
        TOTAL=$(ps 2>/dev/null | grep '[w]ebsocat.*port/guest' | wc -l | tr -d ' ')
        TOTAL=$(printf '%d' "${TOTAL:-0}" 2>/dev/null || echo 0)
        EXPOSE_DATA="{}"
        [ -f "$EXPOSE_FILE" ] && EXPOSE_DATA=$(cat "$EXPOSE_FILE")
        printf '{"code":"%s","relay":"%s","ports":[%s],"pool":%s,"bridges":%s,"uptime":%s,"expose":%s}\n' \
            "$CODE" "$RELAY" "$PORTS_JSON" "$POOL" "$TOTAL" "$UPTIME" "$EXPOSE_DATA" > "$STATUS_FILE"
        sleep 5
    done
}

cmd_down() {
    SAVED_CODE=""
    if [ -f "$CODE_FILE" ]; then
        SAVED_CODE=$(cat "$CODE_FILE")
    fi
    if [ -s "$PID_FILE" ]; then
        kill "$(cat "$PID_FILE")" 2>/dev/null || true
        sleep 1
    fi
    kill_bridges
    # Kill any lingering tunnel-up.sh respawn loops to prevent MaxStartups flooding
    pkill -9 -f 'tunnel-up\.sh' 2>/dev/null || true
    if [ -n "$SAVED_CODE" ]; then
        curl -sS --max-time 5 \
            -X POST "${RELAY}/port/unexpose" \
            -H 'Content-Type: application/json' \
            -d "{\"code\":\"${SAVED_CODE}\"}" >/dev/null 2>&1 || true
        curl -sS --max-time 5 \
            -X POST "${RELAY}/port/unregister" \
            -H 'Content-Type: application/json' \
            -d "{\"code\":\"${SAVED_CODE}\"}" >/dev/null 2>&1 || true
    fi
    rm -f "$CODE_FILE" "$PID_FILE" "$STATUS_FILE" "$EXPOSE_FILE"
    printf 'lot-bridge: stopped\n'
}

# find_free_port PORT — print first local port >= PORT not already bound
find_free_port() {
    local p="$1"
    local max=$(( p + 99 ))
    while [ "$p" -le "$max" ]; do
        if ! nc -z 127.0.0.1 "$p" >/dev/null 2>&1; then
            printf '%s' "$p"
            return 0
        fi
        p=$(( p + 1 ))
    done
    printf '%s' "$1"  # fallback: return original and let the caller fail naturally
}

# start_listener LOCAL_PORT WS_URL — spawn a multi-client TCP→WS listener in background
# Writes bg PID to stdout.
start_listener() {
    local LOCAL="$1" URL="$2"
    if command -v socat >/dev/null 2>&1; then
        socat "TCP-LISTEN:${LOCAL},bind=127.0.0.1,reuseaddr,fork" \
            "EXEC:websocat --binary ${URL},nofork" &
        printf '%s' "$!"
    elif command -v python3 >/dev/null 2>&1; then
        local PYFILE
        PYFILE=$(mktemp /tmp/lot-bridge-XXXXXX.py)
        cat > "$PYFILE" <<'PYEOF'
import os, sys, socket, signal
port = int(sys.argv[1]); url = sys.argv[2]
try: signal.signal(signal.SIGCHLD, signal.SIG_IGN)
except Exception: pass
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("127.0.0.1", port)); s.listen(128)
while True:
    try: c, _ = s.accept()
    except (KeyboardInterrupt, SystemExit): break
    except OSError: continue
    if os.fork() == 0:
        os.dup2(c.fileno(), 0); os.dup2(c.fileno(), 1); c.close()
        os.execvp("websocat", ["websocat", "--binary", url]); os._exit(1)
    c.close()
PYEOF
        python3 "$PYFILE" "$LOCAL" "$URL" &
        local pid="$!"
        printf '%s' "$pid"
        # clean up tempfile once python has loaded it
        ( sleep 2; rm -f "$PYFILE" ) &
    else
        # single-shot respawn fallback (websocat only, one client at a time)
        ( trap '' HUP
          while :; do
              websocat --binary -E "tcp-l:127.0.0.1:${LOCAL}" "$URL" 2>/dev/null
              sleep 0.5 2>/dev/null || sleep 1
          done ) &
        printf '%s' "$!"
    fi
}

cmd_listen() {
    CODE="${1:-}"
    if [ -z "$CODE" ]; then
        printf 'usage: lot-bridge listen CODE\n' >&2
        exit 1
    fi

    if ! command -v websocat >/dev/null 2>&1; then
        printf 'lot-bridge listen: websocat not found\n' >&2
        printf '  macOS: brew install websocat\n' >&2
        exit 1
    fi

    STATUS=$(curl -fsS --max-time 10 "${RELAY}/port/status?code=${CODE}" 2>/dev/null)
    if [ -z "$STATUS" ]; then
        printf 'lot-bridge listen: relay unreachable (code=%s)\n' "$CODE" >&2
        exit 1
    fi

    # Extract comma-separated port list from registered_ports or ports field
    PORTS=$(printf '%s' "$STATUS" | sed -n 's/.*"registered_ports":\[\([0-9,]*\)\].*/\1/p')
    if [ -z "$PORTS" ]; then
        PORTS=$(printf '%s' "$STATUS" | sed -n 's/.*"ports":\[\([0-9,]*\)\].*/\1/p')
    fi
    if [ -z "$PORTS" ]; then
        printf 'lot-bridge listen: no ports found for code %s\n' "$CODE" >&2
        printf '%s\n' "$STATUS" >&2
        exit 1
    fi

    WS=$(relay_ws)
    LISTEN_PIDS=""

    printf '──────────────────────────────────────────────────────\n'
    printf '  lot-bridge listen  code=%s\n\n' "$CODE"

    OLD_IFS="$IFS"; IFS=','
    for PORT in $PORTS; do
        IFS="$OLD_IFS"
        PORT="${PORT# }"; PORT="${PORT% }"
        LOCAL=$(find_free_port "$PORT")
        if [ "$LOCAL" != "$PORT" ]; then
            printf '  :%s in use → local :%s → guest :%s\n' "$PORT" "$LOCAL" "$PORT"
        else
            printf '  local :%s → guest :%s\n' "$LOCAL" "$PORT"
        fi
        URL="${WS}/port/client?code=${CODE}&port=${PORT}"
        pid=$(start_listener "$LOCAL" "$URL")
        LISTEN_PIDS="$LISTEN_PIDS $pid"
        IFS=','
    done
    IFS="$OLD_IFS"

    printf '\n  Ctrl-C to stop.\n'
    printf '──────────────────────────────────────────────────────\n'

    cleanup_listen() {
        printf '\n[lot-bridge listen] stopping\n'
        for p in $LISTEN_PIDS; do
            kill "$p" 2>/dev/null || true
        done
        kill 0 2>/dev/null || true
        exit 0
    }
    trap cleanup_listen INT TERM
    wait
}

CMD="${1:-}"
shift 2>/dev/null || true

case "$CMD" in
    up)
        cmd_up "$@"
        ;;
    down)
        cmd_down
        ;;
    listen)
        cmd_listen "$@"
        ;;
    status)
        if [ -f "$STATUS_FILE" ]; then
            cat "$STATUS_FILE"
        else
            printf '{"running":false}\n'
        fi
        ;;
    --version|-v)
        printf 'lot-bridge 0.1.0 (shell)\n'
        ;;
    *)
        printf 'usage: lot-bridge [up PORTS...|down|listen CODE|status|--version]\n' >&2
        exit 1
        ;;
esac
