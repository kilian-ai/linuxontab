#!/bin/sh
# lot-bridge — persistent WS↔TCP bridge pool (shell implementation)
# Same CLI: up / down / status / --version
# Requires: websocat, curl
# Env: LOT_BRIDGE_RELAY=https://...  LOT_BRIDGE_POOL=N

set -u
trap '' HUP

RELAY="${LOT_BRIDGE_RELAY:-https://linuxontab-tunnel.fly.dev}"
POOL="${LOT_BRIDGE_POOL:-4}"

CODE_FILE=/tmp/lot-bridge.code
PID_FILE=/tmp/lot-bridge.pid
PIDS_FILE=/tmp/lot-bridge.pids
STATUS_FILE=/tmp/lot-bridge.status.json

relay_ws() {
    case "$RELAY" in
        https://*) echo "wss://${RELAY#https://}" ;;
        http://*)  echo "ws://${RELAY#http://}" ;;
        *)         echo "$RELAY" ;;
    esac
}

kill_bridges() {
    if [ -s "$PIDS_FILE" ]; then
        while IFS= read -r pid; do
            [ -n "$pid" ] && kill -9 "$pid" 2>/dev/null || true
        done < "$PIDS_FILE"
    fi
    pkill -9 -f 'websocat.*port/guest' 2>/dev/null || true
    sleep 1; pkill -9 -f 'websocat.*port/guest' 2>/dev/null || true
    rm -f "$PIDS_FILE"
}

track_pid() { printf '%s\n' "$1" >> "$PIDS_FILE"; }

cmd_up() {
    PORTS="$*"
    [ -z "$PORTS" ] && { echo "usage: lot-bridge up PORT [PORT ...]" >&2; exit 1; }
    PORTS_JSON=$(echo "$PORTS" | tr ' ' '\n' | grep -E '^[0-9]+$' | paste -sd ',' -)
    [ -z "$PORTS_JSON" ] && { echo "lot-bridge: no valid ports" >&2; exit 1; }

    [ -s "$PID_FILE" ] && kill "$(cat "$PID_FILE")" 2>/dev/null || true
    kill_bridges
    rm -f "$CODE_FILE" "$STATUS_FILE"

    REG=$(curl -sS --max-time 15 -X POST "${RELAY}/port/register" \
        -H 'Content-Type: application/json' \
        -d "{\"ports\":[$PORTS_JSON]}" 2>/dev/null)
    CODE=$(printf '%s' "$REG" | sed -n 's/.*"code":"\([A-Z0-9]*\)".*/\1/p')
    [ -z "$CODE" ] && { echo "lot-bridge: registration failed: $REG" >&2; exit 1; }

    echo "$CODE" > "$CODE_FILE"
    echo $$ > "$PID_FILE"
    : > "$PIDS_FILE"
    WS=$(relay_ws)
    STARTED=$(date +%s 2>/dev/null || echo 0)
    printf 'lot-bridge: code=%s relay=%s ports=%s pool=%s\n' "$CODE" "$RELAY" "$PORTS_JSON" "$POOL"

    for PORT in $PORTS; do
        I=0
        while [ "$I" -lt "$POOL" ]; do
            I=$((I + 1))
            ( trap '' HUP
              while :; do
                  websocat --binary --ping-interval 25 \
                      "${WS}/port/guest?code=${CODE}&port=${PORT}" \
                      "tcp:127.0.0.1:${PORT}" \
                      >> /tmp/lot-bridge.log 2>&1
                  sleep 0.1 2>/dev/null || sleep 1
              done ) &
            track_pid $!
        done
    done

    trap '
        kill_bridges
        curl -sS --max-time 5 -X POST "${RELAY}/port/unregister" \
            -H "Content-Type: application/json" \
            -d "{\"code\":\"${CODE}\"}" >/dev/null 2>&1 || true
        rm -f "$CODE_FILE" "$PID_FILE" "$STATUS_FILE"; exit 0
    ' TERM INT

    while :; do
        NOW=$(date +%s 2>/dev/null || echo 0)
        UPTIME=$((NOW - STARTED))
        LIVE=0
        [ -s "$PIDS_FILE" ] && while IFS= read -r p; do
            [ -n "$p" ] && kill -0 "$p" 2>/dev/null && LIVE=$((LIVE+1)) || true
        done < "$PIDS_FILE"
        TOTAL=$(wc -l < "$PIDS_FILE" 2>/dev/null | tr -d ' ' || echo 0)
        printf '{"code":"%s","relay":"%s","ports":[%s],"pool_size":%s,"live":%s,"total":%s,"uptime_s":%s,"pid":%s}\n' \
            "$CODE" "$RELAY" "$PORTS_JSON" "$POOL" "$LIVE" "$TOTAL" "$UPTIME" $$ > "$STATUS_FILE"
        sleep 5
    done
}

cmd_down() {
    CODE=""; [ -s "$CODE_FILE" ] && CODE=$(cat "$CODE_FILE")
    [ -s "$PID_FILE" ] && kill "$(cat "$PID_FILE")" 2>/dev/null || true
    kill_bridges
    [ -n "$CODE" ] && curl -sS --max-time 5 -X POST "${RELAY}/port/unregister" \
        -H 'Content-Type: application/json' -d "{\"code\":\"${CODE}\"}" >/dev/null 2>&1 || true
    rm -f "$CODE_FILE" "$PID_FILE" "$STATUS_FILE"
    echo "lot-bridge: stopped"
}

CMD="${1:-}"; shift 2>/dev/null || true
case "$CMD" in
    up)      cmd_up "$@" ;;
    down)    cmd_down ;;
    status)  [ -f "$STATUS_FILE" ] && cat "$STATUS_FILE" || echo '{"running":false}' ;;
    --version|-v) echo "lot-bridge 0.1.0 (shell)" ;;
    *)  printf 'usage: lot-bridge [up PORTS...|down|status|--version]\n' >&2; exit 1 ;;
esac
