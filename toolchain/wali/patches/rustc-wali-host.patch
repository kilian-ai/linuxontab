-    from_env_args_next()
-        .unwrap_or_else(|| default_from_rustc_driver_dll().expect("Failed finding sysroot"))
+    // LinuxOnTab (static rustc_driver, no dladdr): fall back to the executable's own path.
+    from_env_args_next().or_else(|| default_from_rustc_driver_dll().ok()).unwrap_or_else(|| {
