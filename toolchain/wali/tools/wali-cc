#!/bin/sh
# C compiler wrapper for the wasm32-wali-linux-musl target (LLVM 22 clang + wali-musl sysroot).
# The WALI triple goes LAST so it wins over any --target a build system adds (cc crate,
# cmake); -fwasm-exceptions is only for C++ (clang aborts on -fwasm-exceptions + -fno-exceptions).
exec /tmp/llvm22/bin/clang --sysroot=/tmp/wali-sysroot -O2 -pthread -fdeclspec -mcpu=generic -matomics -mbulk-memory -mexception-handling -Wno-implicit-function-declaration -Wno-int-conversion -Wno-incompatible-function-pointer-types -Wno-incompatible-pointer-types -Wno-nullability-completeness "$@" --target=wasm32-unknown-linux-muslwali
