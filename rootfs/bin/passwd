#!/bin/sh
# passwd wrapper — uses busybox cryptpw to avoid BusyBox's broken getpwnam
# Works for the root account in this single-user WASM environment.
USER="${1:-root}"

# Verify user exists directly (bypass getpwnam)
if ! grep -q "^${USER}:" /etc/passwd 2>/dev/null; then
    printf 'passwd: unknown user %s\n' "$USER" >&2
    exit 1
fi

printf 'New password: '
stty -echo 2>/dev/null
read -r PASS1
stty echo 2>/dev/null
echo

printf 'Retype new password: '
stty -echo 2>/dev/null
read -r PASS2
stty echo 2>/dev/null
echo

if [ "$PASS1" != "$PASS2" ]; then
    echo 'passwd: passwords do not match' >&2
    exit 1
fi

# Generate hash using busybox cryptpw (SHA-512, no getpwnam needed)
HASH=$(busybox cryptpw -a sha512 "$PASS1" 2>/dev/null)
if [ -z "$HASH" ]; then
    # fall back to MD5
    HASH=$(busybox cryptpw -a md5 "$PASS1" 2>/dev/null)
fi
if [ -z "$HASH" ]; then
    echo 'passwd: failed to hash password' >&2
    exit 1
fi

# Update /etc/shadow
if [ -f /etc/shadow ]; then
    DAYS=$(awk 'BEGIN{print int(systime()/86400)}' 2>/dev/null || echo 19868)
    if grep -q "^${USER}:" /etc/shadow; then
        sed -i "s|^${USER}:[^:]*:|${USER}:${HASH}:|" /etc/shadow
    else
        printf '%s:%s:%s:0:99999:7:::\n' "$USER" "$HASH" "$DAYS" >> /etc/shadow
    fi
fi

# Update /etc/passwd if it has inline hash (not x)
PW_FIELD=$(grep "^${USER}:" /etc/passwd | cut -d: -f2)
if [ "$PW_FIELD" != "x" ] && [ -n "$PW_FIELD" ]; then
    sed -i "s|^${USER}:[^:]*:|${USER}:${HASH}:|" /etc/passwd
fi

echo "passwd: password updated successfully"
