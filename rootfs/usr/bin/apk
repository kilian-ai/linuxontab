#!/bin/sh
# apk — LinuxOnTab package manager
# Fetches WASM-compiled packages from https://linuxontab.com/packages/
# All packages are real wasm32-linux-musl binaries from tombl/distro

APK_REPO_HTTP="https://linuxontab.com/packages"
APK_REPO_VGWX="http://192.168.86.1/packages"  # virtual gateway (fast, in-rootfs)
APK_LOCAL_REPO="/packages"
APK_DB="/var/lib/apk"
APK_INDEX="$APK_LOCAL_REPO/index.json"  # already in rootfs — no copy needed

_err()  { echo "apk: error: $*" >&2; exit 1; }
_info() { echo ">>> $*"; }
_ok()   { echo "OK: $*"; }

# Resolve a package URL: prefer local copy in /packages/, fall back to HTTP.
_fetch() {
    local url="$1" out="$2" rel=""
    case "$url" in
        http://192.168.86.1/packages/*)    rel="${url#http://192.168.86.1/packages/}" ;;
        https://linuxontab.com/packages/*) rel="${url#https://linuxontab.com/packages/}" ;;
    esac
    if [ -n "$rel" ] && [ -f "$APK_LOCAL_REPO/$rel" ]; then
        cp "$APK_LOCAL_REPO/$rel" "$out"
        return $?
    fi
    wget -q -O "$out" "$url" || true
    [ -s "$out" ] || { echo "apk: download failed: $url" >&2; return 1; }
}

# Pure-shell JSON field extractors — no external commands (awk/sed/grep hang at
# asyncify fork depth ≥ 3).  Reads APK_INDEX directly via shell redirection.
# APK_INDEX format (2-space indent at top, 4-space for pkg keys, 6-space fields):
#   {
#     "packages": {
#       "pkgname": {
#         "version": "...",
#         "size": 12345,
#         ...
#       },
#     }
#   }
_pkg_field() {
    local pkg="$1" field="$2" _in=0 _l
    while IFS= read -r _l; do
        case "$_in:$_l" in
            0:'    "'"$pkg"'": {'*)  _in=1 ;;
            1:'      "'"$field"'": "'*)
                _l="${_l#*\"$field\": \"}"; printf '%s\n' "${_l%%\"*}"; return 0 ;;
            1:'    }'*)  return 1 ;;
        esac
    done < "$APK_INDEX"
}

_pkg_field_num() {
    local pkg="$1" field="$2" _in=0 _l
    while IFS= read -r _l; do
        case "$_in:$_l" in
            0:'    "'"$pkg"'": {'*)  _in=1 ;;
            1:'      "'"$field"'": '[0-9]*)
                _l="${_l#*\"$field\": }"; printf '%s\n' "${_l%%[^0-9]*}"; return 0 ;;
            1:'    }'*)  return 1 ;;
        esac
    done < "$APK_INDEX"
}

cmd_update() {
    # APK_INDEX points directly to /packages/index.json which is baked into the
    # rootfs — no network fetch or file copy needed.
    if [ -f "$APK_INDEX" ]; then
        _ok "Package index ready ($APK_INDEX)"
        return 0
    fi
    _err "Package index missing — rootfs may be corrupt"
}

cmd_list() {
    local filter="$1" _pkg _ver _desc _inst _in _l
    [ -f "$APK_INDEX" ] || { _info "Index not found — run: apk update"; return 1; }
    echo "Available packages:"
    echo "-------------------"
    _in=0; _pkg=""; _ver=""; _desc=""
    while IFS= read -r _l; do
        case "$_in:$_l" in
            0:'    "'*'": {')
                _pkg="${_l#    \"}"; _pkg="${_pkg%%\"*}"
                _ver=""; _desc=""; _in=1 ;;
            1:'      "version": "'*)
                _ver="${_l#*\"version\": \"}"; _ver="${_ver%%\"*}" ;;
            1:'      "description": "'*)
                _desc="${_l#*\"description\": \"}"; _desc="${_desc%%\"*}" ;;
            1:'    }'*)
                if [ -n "$_pkg" ] && [ -n "$_ver" ]; then
                    _inst=""
                    [ -f "$APK_DB/installed/$_pkg" ] && _inst=" [installed]"
                    if [ -z "$filter" ]; then
                        printf "  %-16s %-12s %s%s\n" "$_pkg" "$_ver" "$_desc" "$_inst"
                    else
                        case "$_pkg $_ver $_desc" in
                            *"$filter"*) printf "  %-16s %-12s %s%s\n" "$_pkg" "$_ver" "$_desc" "$_inst" ;;
                        esac
                    fi
                fi
                _in=0; _pkg="" ;;
        esac
    done < "$APK_INDEX"
}

cmd_info() {
    local pkg="$1" ver desc url size sha _inst_ver
    [ -n "$pkg" ] || _err "Usage: apk info <package>"
    [ -f "$APK_INDEX" ] || _err "Index not found. Run: apk update"
    ver=$(_pkg_field "$pkg" "version")
    [ -n "$ver" ] || _err "Unknown package: $pkg"
    desc=$(_pkg_field "$pkg" "description")
    url=$(_pkg_field "$pkg" "url")
    size=$(_pkg_field_num "$pkg" "size")
    sha=$(_pkg_field "$pkg" "sha256")
    echo "Package    : $pkg"
    echo "Version    : $ver"
    echo "Description: $desc"
    echo "URL        : $url"
    echo "Size       : $size bytes"
    echo "SHA256     : $sha"
    if [ -f "$APK_DB/installed/$pkg" ]; then
        IFS= read -r _inst_ver < "$APK_DB/installed/$pkg"
        echo "Status     : installed ($_inst_ver)"
    else
        echo "Status     : not installed"
    fi
}

cmd_add() {
    [ -n "$*" ] || _err "Usage: apk add <package> [package...]"
    [ -f "$APK_INDEX" ] || cmd_update
    for pkg in "$@"; do
        _install_pkg "$pkg"
    done
}

_install_pkg() {
    local pkg="$1" ver url sha inst_ver tmptar workdir pkgroot manifest _entry _rel
    ver=$(_pkg_field "$pkg" "version")
    [ -n "$ver" ] || _err "Unknown package: $pkg (run 'apk update' to refresh index)"

    if [ -f "$APK_DB/installed/$pkg" ]; then
        IFS= read -r inst_ver < "$APK_DB/installed/$pkg"
        if [ "$inst_ver" = "$ver" ]; then
            _info "$pkg-$ver is already installed"
            return 0
        fi
        _info "Upgrading $pkg: $inst_ver -> $ver"
    else
        _info "Installing $pkg-$ver..."
    fi

    url=$(_pkg_field "$pkg" "url")
    sha=$(_pkg_field "$pkg" "sha256")
    [ -n "$url" ] || _err "No URL for package $pkg"

    tmptar="/tmp/apk-$pkg.tar.gz"
    _info "Downloading $url"
    _fetch "$url" "$tmptar" || _err "Download failed for $pkg"

    # Optional checksum verification (sha256sum is a single fork at depth 2 — OK)
    if command -v sha256sum >/dev/null 2>&1 && [ -n "$sha" ]; then
        actual=$(sha256sum "$tmptar"); actual="${actual%% *}"
        if [ "$actual" != "$sha" ]; then
            rm -f "$tmptar"
            _err "Checksum mismatch for $pkg (expected $sha, got $actual)"
        fi
    fi

    _info "Extracting $pkg..."
    workdir="/tmp/apk-work-$pkg"
    rm -rf "$workdir" && mkdir -p "$workdir"
    tar xzf "$tmptar" -C "$workdir" 2>/dev/null || _err "Failed to extract tarball"

    pkgroot="$workdir/pkg-$pkg"
    [ -d "$pkgroot" ] || _err "Malformed tarball: pkg-$pkg/ not found"

    # Install: copy entire pkg tree to / preserving permissions.
    # Packages are pre-asyncify-transformed at build time (make-packages.sh).
    # cp -rp is a single depth-2 fork — safe in the asyncify fork chain.
    mkdir -p "$APK_DB/files"
    manifest="$APK_DB/files/$pkg"
    : > "$manifest"
    cp -rp "$pkgroot/." / 2>/dev/null || _err "Failed to install files for $pkg"
    _ok "Installed $pkg files to /"

    # Build manifest via tar -t (single fork, no pipeline) then pure-shell parse
    tar tzf "$tmptar" > "/tmp/apk-fl-$pkg.txt" 2>/dev/null || true
    while IFS= read -r _entry; do
        case "$_entry" in
            */) continue ;;          # skip directory entries
            pkg-*/*)
                _rel="${_entry#*/}"  # strip "pkg-NAME/" prefix
                echo "/$_rel" >> "$manifest" ;;
        esac
    done < "/tmp/apk-fl-$pkg.txt"
    rm -f "/tmp/apk-fl-$pkg.txt" "$tmptar"

    # Record installed version
    mkdir -p "$APK_DB/installed"
    echo "$ver" > "$APK_DB/installed/$pkg"
    _ok "$pkg-$ver installed"
}

cmd_del() {
    [ -n "$*" ] || _err "Usage: apk del <package> [package...]"
    for pkg in "$@"; do
        [ -f "$APK_DB/installed/$pkg" ] || { echo "apk: $pkg is not installed"; continue; }
        local manifest="$APK_DB/files/$pkg"
        if [ -f "$manifest" ]; then
            while IFS= read -r f; do
                [ -z "$f" ] && continue
                rm -f "$f" && _ok "Removed: $f"
            done < "$manifest"
            rm -f "$manifest"
        fi
        rm -f "$APK_DB/installed/$pkg"
        _ok "$pkg removed"
    done
}

cmd_upgrade() {
    cmd_update
    # Use glob instead of $(ls ...) to avoid depth-3 fork
    for _f in "$APK_DB/installed/"*; do
        [ -f "$_f" ] || continue
        _install_pkg "${_f##*/}"
    done
}

cmd_search() {
    cmd_list "$1"
}

cmd_version() {
    echo "apk-linuxontab 0.3.0"
    echo "WASM package manager for LinuxOnTab"
    echo "Local repo  : $APK_LOCAL_REPO"
    echo "Remote repo : $APK_REPO_HTTP"
}

cmd_help() {
    cat <<'EOF'
apk - LinuxOnTab package manager (WASM packages)

Commands:
  apk update           Fetch/refresh the package index
  apk add <pkg>...     Install package(s)
  apk del <pkg>...     Remove package(s)
  apk list [filter]    List available packages
  apk search <query>   Search packages by name/description
  apk info <pkg>       Show package details
  apk upgrade          Update index and upgrade all installed packages
  apk version          Show apk version

Notes:
  All packages are compiled to WebAssembly (wasm32-linux-musl)
  and built from source via github.com/tombl/distro.

  Wasmer.io / WAPM packages are NOT compatible — they use WASI
  (wasi_snapshot_preview1) rather than Linux syscall ABI.

  To build a new package from source:
    rebuild --skip-distro     (triggers GitHub Actions CI)
EOF
}

# Dispatch
CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
    update)   cmd_update ;;
    add)      cmd_add "$@" ;;
    del|remove|delete) cmd_del "$@" ;;
    list)     cmd_list "$@" ;;
    search)   cmd_search "$1" ;;
    info)     cmd_info "$1" ;;
    upgrade)  cmd_upgrade ;;
    version|-v|--version) cmd_version ;;
    help|-h|--help) cmd_help ;;
    *)
        echo "apk: unknown command: $CMD"
        cmd_help
        exit 1
        ;;
esac
