#!/bin/sh
# apk — LinuxOnTab package manager
# Fetches WASM-compiled packages from https://linuxontab.com/packages/
# All packages are real wasm32-linux-musl binaries from tombl/distro

APK_REPO_HTTP="https://linuxontab.com/packages"
APK_REPO_VGWX="http://192.168.86.1/packages"  # virtual gateway (fast, in-rootfs)
APK_LOCAL_REPO="/packages"
APK_DB="/var/lib/apk"
APK_CACHED_INDEX="/var/cache/apk/index.json"  # fetched by 'apk update'
APK_INDEX="$APK_LOCAL_REPO/index.json"         # baked-in fallback
# Prefer live-fetched index if available and valid (contains "packages" key)
if [ -f "$APK_CACHED_INDEX" ] && grep -q '"packages"' "$APK_CACHED_INDEX" 2>/dev/null; then
    APK_INDEX="$APK_CACHED_INDEX"
fi

_err()  { echo "apk: error: $*" >&2; exit 1; }
_info() { echo ">>> $*"; }
_ok()   { echo "OK: $*"; }

# Download one URL to a file. Prefer lotfetch (tiny HTTP client that proxies
# any http/https URL through the JS gateway — no DNS/TLS in the guest; the
# lean busybox has no wget applet). Fall back to wget where lotfetch is absent.
_dl() {
    if [ -x /usr/bin/lotfetch ]; then
        /usr/bin/lotfetch "$1" "$2" 2>/dev/null
    else
        wget -q -O "$2" "$1"
    fi
}

# Fast path: ask the page to load the tarball into the package drop disk
# (/dev/vdb, virtio-blk — immune to the guest TCP bulk-RX wedge), then read
# it back block-side. The HTTP exchange here is a tiny JSON only.
_fetch_pkgdrop() {
    local rel="$1" out="$2" _resp _size
    [ -x /usr/bin/lotfetch ] || return 1
    [ -b /dev/vdb ] || return 1
    _resp="/tmp/apk-drop-$$.json"
    /usr/bin/lotfetch "http://192.168.86.1/_pkgdrop/$rel" "$_resp" 2>/dev/null || { rm -f "$_resp"; return 1; }
    grep -q '"ok": *1' "$_resp" 2>/dev/null || { rm -f "$_resp"; return 1; }
    awk -F'"size": *' '{ if (NF>1) { v=$2; sub(/[^0-9].*/,"",v); print v; exit } }' \
        "$_resp" > "$_resp.size" 2>/dev/null
    _size=""
    read -r _size < "$_resp.size" 2>/dev/null || _size=""
    rm -f "$_resp" "$_resp.size"
    [ -n "$_size" ] && [ "$_size" -gt 0 ] 2>/dev/null || return 1
    head -c "$_size" /dev/vdb > "$out" 2>/dev/null || return 1
    [ -s "$out" ] || return 1
    return 0
}

# Resolve a package URL: prefer local copy in /packages/, fall back to HTTP.
_fetch() {
    local url="$1" out="$2" rel=""
    case "$url" in
        http://192.168.86.1/packages/*)    rel="${url#http://192.168.86.1/packages/}" ;;
        https://linuxontab.com/packages/*) rel="${url#https://linuxontab.com/packages/}" ;;
    esac
    if [ -n "$rel" ] && [ -f "$APK_LOCAL_REPO/$rel" ]; then
        cp "$APK_LOCAL_REPO/$rel" "$out"
        return $?
    fi
    # Drop-disk first: bulk bytes via virtio-blk, tiny JSON via HTTP. The
    # sha256 check in _install_pkg still guards the result.
    if [ -n "$rel" ] && _fetch_pkgdrop "$rel" "$out"; then
        return 0
    fi
    # Gateway next: origin-form /packages/<rel> is served same-origin by the
    # page (dev server or the deployed site), no TLS in the guest. Fall back
    # to the absolute URL from the index (via the wget https->gateway rewrite).
    if [ -n "$rel" ]; then
        if _dl "$APK_REPO_VGWX/$rel" "$out" && [ -s "$out" ]; then
            return 0
        fi
        rm -f "$out"   # never keep a partial download
    fi
    if _dl "$url" "$out" && [ -s "$out" ]; then
        return 0
    fi
    rm -f "$out"
    echo "apk: download failed: $url" >&2; return 1
}

# Pure-shell JSON field extractors — no external commands (awk/sed/grep hang at
# asyncify fork depth ≥ 3).  Reads APK_INDEX directly via shell redirection.
# APK_INDEX format (2-space indent at top, 4-space for pkg keys, 6-space fields):
#   {
#     "packages": {
#       "pkgname": {
#         "version": "...",
#         "size": 12345,
#         ...
#       },
#     }
#   }
_pkg_field() {
    # Use awk — avoids busybox ash WASM case-pattern quoting bugs.
    # awk runs as a direct child of apk (fork depth 3), same as grep in cmd_update.
    awk -v p="$1" -v f="$2" '
        index($0, "\"" p "\": {") > 0 { in_pkg=1; next }
        in_pkg && index($0, "\"" f "\": \"") > 0 {
            i = index($0, "\"" f "\": \"") + length(f) + 5
            v = substr($0, i); sub(/".*/, "", v); print v; exit
        }
        in_pkg && /}/ { exit }
    ' "$APK_INDEX"
}

_pkg_field_num() {
    awk -v p="$1" -v f="$2" '
        index($0, "\"" p "\": {") > 0 { in_pkg=1; next }
        in_pkg && index($0, "\"" f "\": ") > 0 {
            i = index($0, "\"" f "\": ") + length(f) + 4
            v = substr($0, i) + 0; print v; exit
        }
        in_pkg && /}/ { exit }
    ' "$APK_INDEX"
}

# Print a package's runtime dependencies (from its "depends": [...] array),
# space-separated. Handles the multi-line array json.dump(indent=2) emits.
_pkg_depends() {
    awk -v p="$1" '
        index($0, "\"" p "\": {") > 0 { in_pkg=1; next }
        in_pkg && /"depends"/ { grab=1 }
        grab {
            buf = buf " " $0
            if (index($0, "]") > 0) {
                sub(/.*\[/, "", buf); sub(/\].*/, "", buf)
                gsub(/[",]/, " ", buf); print buf; exit
            }
            next
        }
        in_pkg && /^[[:space:]]*\}/ { exit }
    ' "$APK_INDEX"
}

cmd_update() {
    local tmpidx="/tmp/apk-index-$$.json"
    mkdir -p /var/cache/apk
    _info "Fetching package index..."
    # Try virtual gateway first (fast, served locally by wasm.html)
    if _dl "$APK_REPO_VGWX/index.json" "$tmpidx" 2>/dev/null && \
       [ -s "$tmpidx" ] && grep -q '"packages"' "$tmpidx" 2>/dev/null; then
        mv "$tmpidx" "$APK_CACHED_INDEX"
        APK_INDEX="$APK_CACHED_INDEX"
        _ok "Package index updated from virtual gateway"
        return 0
    fi
    # Fall back to HTTPS registry
    if _dl "$APK_REPO_HTTP/index.json" "$tmpidx" 2>/dev/null && \
       [ -s "$tmpidx" ] && grep -q '"packages"' "$tmpidx" 2>/dev/null; then
        mv "$tmpidx" "$APK_CACHED_INDEX"
        APK_INDEX="$APK_CACHED_INDEX"
        _ok "Package index updated from $APK_REPO_HTTP"
        return 0
    fi
    rm -f "$tmpidx"
    # Fall back gracefully
    if [ -f "$APK_CACHED_INDEX" ]; then
        APK_INDEX="$APK_CACHED_INDEX"
        _info "Warning: could not reach package server — using cached index"
    elif [ -f "$APK_LOCAL_REPO/index.json" ]; then
        APK_INDEX="$APK_LOCAL_REPO/index.json"
        _ok "Using baked-in package index"
    else
        _err "Package index unavailable"
    fi
}

cmd_list() {
    local filter="$1" _tmp _pkg _ver _desc _inst _l
    [ -f "$APK_INDEX" ] || { _info "Index not found — run: apk update"; return 1; }
    echo "Available packages:"
    echo "-------------------"
    _tmp="/tmp/apk-list-$$"
    # awk extracts pkg|ver|desc lines; pure-shell loop handles install status
    awk '
        /"packages": \{/ { in_pkgs=1; next }
        !in_pkgs { next }
        /"[^"]+": \{/ {
            s=$0; sub(/^[^"]*"/, "", s); sub(/": \{.*/, "", s)
            pkg=s; ver=""; desc=""
        }
        pkg && /"version": "/ {
            s=$0; sub(/.*"version": "/, "", s); sub(/".*/, "", s); ver=s
        }
        pkg && /"description": "/ {
            s=$0; sub(/.*"description": "/, "", s); sub(/".*/, "", s); desc=s
        }
        pkg && /^[[:space:]]*\}/ && ver != "" {
            print pkg "|" ver "|" desc; pkg=""; ver=""; desc=""
        }
    ' "$APK_INDEX" > "$_tmp"
    while read -r _l; do
        _pkg="${_l%%|*}"
        _ver="${_l#*|}"; _ver="${_ver%%|*}"
        _desc="${_l##*|}"
        _inst=""
        [ -f "$APK_DB/installed/$_pkg" ] && _inst=" [installed]"
        # NB: no quoted case patterns (*"$filter"*) — the wasm hush build
        # misparses them ("syntax error: unexpected )"). grep instead.
        if [ -z "$filter" ] || echo "$_pkg $_ver $_desc" | grep -q "$filter"; then
            printf "  %-16s %-12s %s%s\n" "$_pkg" "$_ver" "$_desc" "$_inst"
        fi
    done < "$_tmp"
    rm -f "$_tmp"
}

cmd_info() {
    local pkg="$1" ver desc url size sha _inst_ver _tmpout
    [ -n "$pkg" ] || _err "Usage: apk info <package>"
    [ -f "$APK_INDEX" ] || _err "Index not found. Run: apk update"
    _tmpout="/tmp/apk-tmp-$$"
    _pkg_field     "$pkg" "version"     > "$_tmpout" 2>/dev/null; read -r ver  < "$_tmpout"; rm -f "$_tmpout"
    [ -n "$ver" ] || _err "Unknown package: $pkg"
    _pkg_field     "$pkg" "description" > "$_tmpout" 2>/dev/null; read -r desc < "$_tmpout"; rm -f "$_tmpout"
    _pkg_field     "$pkg" "url"         > "$_tmpout" 2>/dev/null; read -r url  < "$_tmpout"; rm -f "$_tmpout"
    _pkg_field_num "$pkg" "size"        > "$_tmpout" 2>/dev/null; read -r size < "$_tmpout"; rm -f "$_tmpout"
    _pkg_field     "$pkg" "sha256"      > "$_tmpout" 2>/dev/null; read -r sha  < "$_tmpout"; rm -f "$_tmpout"
    echo "Package    : $pkg"
    echo "Version    : $ver"
    echo "Description: $desc"
    echo "URL        : $url"
    echo "Size       : $size bytes"
    echo "SHA256     : $sha"
    if [ -f "$APK_DB/installed/$pkg" ]; then
        read -r _inst_ver < "$APK_DB/installed/$pkg"
        echo "Status     : installed ($_inst_ver)"
    else
        echo "Status     : not installed"
    fi
}

cmd_add() {
    [ -n "$*" ] || _err "Usage: apk add <package> [package...]"
    [ -f "$APK_INDEX" ] || cmd_update
    APK_SEEN="/tmp/apk-seen-$$"; : > "$APK_SEEN"
    for pkg in "$@"; do
        _install_pkg "$pkg"
    done
    rm -f "$APK_SEEN"
}

_install_pkg() {
    local pkg="$1" ver url sha inst_ver tmptar workdir pkgroot manifest _entry _rel _tmpout deps d
    # Use redirect capture (not $(...)) so _pkg_field runs in the current shell
    # with no extra fork — $() at depth 3 hangs in the asyncify fork chain.
    _tmpout="/tmp/apk-tmp-$$"
    _pkg_field "$pkg" "version" > "$_tmpout" 2>/dev/null
    read -r ver < "$_tmpout" 2>/dev/null || ver=""; rm -f "$_tmpout"
    [ -n "$ver" ] || _err "Unknown package: $pkg (run 'apk update' to refresh index)"

    if [ -f "$APK_DB/installed/$pkg" ]; then
        read -r inst_ver < "$APK_DB/installed/$pkg"
        if [ "$inst_ver" = "$ver" ]; then
            _info "$pkg-$ver is already installed"
            return 0
        fi
        _info "Upgrading $pkg: $inst_ver -> $ver"
    else
        _info "Installing $pkg-$ver..."
    fi

    # Resolve + install runtime dependencies first (depth-first). The seen-list
    # guards against cycles. NB: this whole script must contain NO $(...) at
    # all and NO quoted case patterns — the wasm hush build fails to PARSE
    # both ("syntax error: unexpected )"), which kills the entire script.
    # NB: no quoted case patterns (*" $pkg "*) — the wasm hush build misparses
    # them ("syntax error: unexpected )"). The seen-list is one name per line,
    # so whole-line grep does the same membership test.
    APK_SEEN="${APK_SEEN:-/tmp/apk-seen-$$}"
    grep -qx "$pkg" "$APK_SEEN" 2>/dev/null || echo "$pkg" >> "$APK_SEEN"
    # Redirect capture, not deps=$(...): the wasm hush build fails to parse
    # $(...) in assignments at all ("syntax error: unexpected )").
    _pkg_depends "$pkg" > "$_tmpout" 2>/dev/null
    deps=""
    read -r deps < "$_tmpout" 2>/dev/null || deps=""
    rm -f "$_tmpout"
    for d in $deps; do
        [ -n "$d" ] || continue
        grep -qx "$d" "$APK_SEEN" 2>/dev/null && continue
        if [ ! -f "$APK_DB/installed/$d" ]; then
            _info "$pkg depends on $d — installing it first"
            _install_pkg "$d"
        fi
    done

    _pkg_field "$pkg" "url"    > "$_tmpout" 2>/dev/null
    read -r url < "$_tmpout" 2>/dev/null || url=""; rm -f "$_tmpout"
    _pkg_field "$pkg" "sha256" > "$_tmpout" 2>/dev/null
    read -r sha < "$_tmpout" 2>/dev/null || sha=""; rm -f "$_tmpout"
    [ -n "$url" ] || _err "No URL for package $pkg"

    # /var/tmp (ext4), NOT /tmp (tmpfs = guest RAM): a 45 MB tarball plus its
    # ~250 MB extracted tree in tmpfs exhausts guest memory (nommu alloc
    # failures -> RCU stall). The rootfs has ~500 MB free.
    mkdir -p /var/tmp
    tmptar="/var/tmp/apk-$pkg.tar.gz"
    _info "Downloading $url"
    _fetch "$url" "$tmptar" || _err "Download failed for $pkg"

    # Checksum: run sha256sum as a direct depth-3 fork (not inside $(...)) to
    # avoid creating a depth-4 process which hangs in the asyncify fork chain.
    if command -v sha256sum >/dev/null 2>&1 && [ -n "$sha" ]; then
        sha256sum "$tmptar" > "$_tmpout" 2>/dev/null
        read -r actual < "$_tmpout" 2>/dev/null || actual=""; rm -f "$_tmpout"
        actual="${actual%% *}"
        if [ "$actual" != "$sha" ]; then
            rm -f "$tmptar"
            _err "Checksum mismatch for $pkg (expected $sha, got $actual)"
        fi
    fi

    _info "Extracting $pkg..."
    workdir="/var/tmp/apk-work-$pkg"
    rm -rf "$workdir" && mkdir -p "$workdir"
    tar xzf "$tmptar" -C "$workdir" 2>/dev/null || _err "Failed to extract tarball"

    pkgroot="$workdir/pkg-$pkg"
    [ -d "$pkgroot" ] || _err "Malformed tarball: pkg-$pkg/ not found"

    # Build manifest and remove conflicting symlinks (e.g. busybox applet stubs)
    # before installing — cp -rp would otherwise follow the symlink and overwrite
    # the target binary (e.g. /bin/busybox) instead of replacing the symlink.
    mkdir -p "$APK_DB/files"
    manifest="$APK_DB/files/$pkg"
    : > "$manifest"
    # Build from extracted filesystem tree instead of tar listing format.
    # Some tar implementations prefix entries with ./ which breaks simple
    # pattern matching and can skip symlink cleanup for /bin applet stubs.
    find "$pkgroot" -type f | while read -r _entry; do
        _rel="${_entry#$pkgroot/}"
        _dest="/$_rel"
        [ -L "$_dest" ] && rm -f "$_dest"
        echo "$_dest" >> "$manifest"
    done

    # Install: copy entire pkg tree to / preserving permissions.
    # Packages are pre-asyncify-transformed at build time (make-packages.sh).
    # cp -rp is a single depth-2 fork — safe in the asyncify fork chain.
    cp -rp "$pkgroot/." / 2>/dev/null || _err "Failed to install files for $pkg"
    # Make installed files executable (WASM binaries require +x).
    # Use the manifest (installed paths) not pkgroot — cp already happened.
    # BATCHED via xargs: a per-file `chmod` loop forks once per file — ~10k
    # forks for python3 — and every nommu fork needs a ~2.2 MB contiguous
    # allocation; under the page-cache pressure of a big extract that
    # fragments and fails (nommu alloc failures -> RCU stall).
    tr '\n' '\0' < "$manifest" | xargs -0 chmod +x 2>/dev/null || true
    _ok "Installed $pkg files to /"

    # Keep curl/wget HTTPS wrappers active even after package installs that
    # may replace busybox applet links or install a non-TLS curl binary.
    /usr/local/sbin/install-https-tools >/dev/null 2>&1 || true

    rm -f "$tmptar"

    # Record installed version
    mkdir -p "$APK_DB/installed"
    echo "$ver" > "$APK_DB/installed/$pkg"
    _ok "$pkg-$ver installed"
}

cmd_del() {
    [ -n "$*" ] || _err "Usage: apk del <package> [package...]"
    for pkg in "$@"; do
        [ -f "$APK_DB/installed/$pkg" ] || { echo "apk: $pkg is not installed"; continue; }
        local manifest="$APK_DB/files/$pkg"
        if [ -f "$manifest" ]; then
            while read -r f; do
                [ -z "$f" ] && continue
                rm -f "$f" && _ok "Removed: $f"
            done < "$manifest"
            rm -f "$manifest"
        fi
        rm -f "$APK_DB/installed/$pkg"
        _ok "$pkg removed"
    done
}

cmd_upgrade() {
    cmd_update
    # Use glob instead of $(ls ...) to avoid depth-3 fork
    for _f in "$APK_DB/installed/"*; do
        [ -f "$_f" ] || continue
        _install_pkg "${_f##*/}"
    done
}

cmd_search() {
    cmd_list "$1"
}

# ── Auto-install stubs (lean boot) ──────────────────────────────────────────
# The lean image ships a tiny stub script at every package binary path:
#   #!/bin/sh
#   exec /usr/bin/apk exec-install <pkg> /path/to/bin "$@"
# First invocation lands here: install the package (which overwrites the stub
# with the real binary), then exec that real binary. The stub uses `exec`, so
# apk runs at the same fork depth as the command the user typed.
_is_stub() {
    # NB: no quoted case patterns here — the wasm hush build misparses them
    # ("syntax error: unexpected )"). A grep for the stub marker is enough:
    # real binaries never contain this exact string.
    [ -f "$1" ] || return 1
    grep -q 'apk exec-install' "$1" 2>/dev/null
}

cmd_exec_install() {
    [ $# -ge 2 ] || _err "Usage: apk exec-install <pkg> <bin-path> [args...]"
    local pkg="$1" bin="$2"
    shift 2
    if ! _is_stub "$bin"; then
        exec "$bin" "$@"       # already installed (raced with another shell)
    fi
    echo "[apk] first use of ${bin##*/} — installing $pkg ..." >&2
    cmd_add "$pkg" >&2 || _err "auto-install of $pkg failed"
    _is_stub "$bin" && _err "$bin is still a stub after installing $pkg"
    exec "$bin" "$@"
}

cmd_version() {
    echo "apk-linuxontab 0.6.0"
    echo "WASM package manager for LinuxOnTab"
    echo "Local repo  : $APK_LOCAL_REPO"
    echo "Remote repo : $APK_REPO_HTTP"
    echo "Cached index: $APK_CACHED_INDEX"
}

cmd_help() {
    cat <<'EOF'
apk - LinuxOnTab package manager (WASM packages)

Commands:
  apk update           Fetch package index from linuxontab.com/packages
  apk add <pkg>...     Install package(s) + their runtime dependencies
  apk del <pkg>...     Remove package(s)
  apk list [filter]    List available packages
  apk search <query>   Search packages by name/description
  apk info <pkg>       Show package details
  apk upgrade          Update index and upgrade all installed packages
  apk version          Show apk version

Notes:
  All packages are compiled to WebAssembly (wasm32-linux-musl)
  and built from source via github.com/tombl/distro.

  Wasmer.io / WAPM packages are NOT compatible — they use WASI
  (wasi_snapshot_preview1) rather than Linux syscall ABI.

  To build a new package from source (on the host Mac):
    cd ~/.ai/LinuxOnTab-kernel
    ./packages/build-package.sh <recipe-name>
    # See packages/recipes/ for available recipes
EOF
}

# Dispatch
CMD="${1:-help}"
shift 2>/dev/null || true

case "$CMD" in
    update)   cmd_update ;;
    add)      cmd_add "$@" ;;
    exec-install) cmd_exec_install "$@" ;;
    del|remove|delete) cmd_del "$@" ;;
    list)     cmd_list "$@" ;;
    search)   cmd_search "$1" ;;
    info)     cmd_info "$1" ;;
    upgrade)  cmd_upgrade ;;
    version|-v|--version) cmd_version ;;
    help|-h|--help) cmd_help ;;
    *)
        echo "apk: unknown command: $CMD"
        cmd_help
        exit 1
        ;;
esac
