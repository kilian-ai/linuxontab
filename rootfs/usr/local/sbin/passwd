#!/bin/sh
# passwd wrapper — uses busybox cryptpw via temp file (no $() subshell —
# command substitution hangs in this WASM hush/ash environment).
USER="${1:-root}"
_TMP=/tmp/passwd-hash-$$

# Verify user exists (bypass broken BusyBox getpwnam)
grep -q "^${USER}:" /etc/passwd 2>/dev/null || {
    printf 'passwd: unknown user %s\n' "$USER" >&2
    exit 1
}

printf 'New password: '
stty -echo 2>/dev/null
read -r PASS1
stty echo 2>/dev/null
echo

printf 'Retype new password: '
stty -echo 2>/dev/null
read -r PASS2
stty echo 2>/dev/null
echo

if [ "$PASS1" != "$PASS2" ]; then
    echo 'passwd: passwords do not match' >&2
    exit 1
fi

# Generate hash into temp file — avoids $() hang
busybox cryptpw -a md5 "$PASS1" > "$_TMP" 2>/dev/null
# Read result without $()
HASH=
while IFS= read -r line; do HASH="$line"; done < "$_TMP"
rm -f "$_TMP"

if [ -z "$HASH" ]; then
    echo 'passwd: failed to hash password' >&2
    exit 1
fi

# Update /etc/shadow
if [ -f /etc/shadow ]; then
    if grep -q "^${USER}:" /etc/shadow; then
        sed -i "s|^${USER}:[^:]*:|${USER}:${HASH}:|" /etc/shadow
    else
        printf '%s:%s:19868:0:99999:7:::\n' "$USER" "$HASH" >> /etc/shadow
    fi
fi

# Always update /etc/passwd inline hash (dropbear has no shadow support)
sed -i "s|^${USER}:[^:]*:|${USER}:${HASH}:|" /etc/passwd

echo 'passwd: password updated successfully'
