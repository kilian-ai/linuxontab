#!/bin/sh
# tunnel-up — start wsbridge pool (no HTTP registration needed)
# Usage: tunnel-up [CODE]
#
# wsbridge connects to ws://linuxontab-tunnel.fly.dev:4344/port/guest
# which auto-creates the session on first connect — no wget/HTTPS needed.
POOL=3
CODE="${1:-}"
if [ -z "$CODE" ]; then
  # Generate a random 4-char alphanumeric code
  CODE=$(cat /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n' | \
         fold -w1 | head -c 64 | tr 'a-f0-9' 'A-F0-9' | \
         grep -oE '[A-Z0-9]' | head -c 4 | tr -d '\n')
  # Fallback if urandom or od missing
  [ ${#CODE} -lt 4 ] && CODE="LOT1"
fi
echo "$CODE" > /tmp/tunnel.code
echo "[tunnel-up] CODE: $CODE"
for PORT in 22 8080; do
  for i in $(seq 1 $POOL); do
    (while :; do /usr/local/bin/wsbridge "$CODE" "$PORT"; sleep 1; done) &
  done
  echo "  port $PORT: $POOL bridges started"
done
echo ""
echo "Connect from Mac:"
echo "  sh <(curl -sS https://linuxontab.com/local/tunnel-listen.sh) $CODE"
echo "  ssh -p 2222 -o StrictHostKeyChecking=no root@localhost"
echo ""
echo "One-liner SSH:"
echo "  sh <(curl -sS https://linuxontab.com/local/tunnel-ssh.sh) $CODE"
