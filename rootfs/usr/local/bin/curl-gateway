#!/bin/sh
# curl wrapper — rewrite https:// URLs into the JS gateway's _https/ prefix
# so the host browser performs TLS via fetch(), avoiding WASM software TLS.
#
# Bypass with:  busybox curl [args]
args=
for a in "$@"; do
  case "$a" in
    https://*) a="http://192.168.86.1/_https/${a#https://}";;
  esac
  args="$args $a"
done
# Disable proxy for rewritten URLs — they already target the gateway.
http_proxy= https_proxy= HTTP_PROXY= HTTPS_PROXY= exec busybox curl $args
